{
  "meta": {
    "name": "Portfolio Brutalist",
    "version": "1.0.0",
    "owner": "[NAMA KAMU]",
    "role": "[PROFESI / BIDANG]",
    "tagline": "[SATU KALIMAT TENTANG KAMU]",
    "language": "id",
    "style": "neo-brutalism",
    "stack": {
      "framework": "Next.js (App Router, output: export)",
      "language": "TypeScript",
      "styling": "Tailwind CSS",
      "animation": ["motion", "gsap + ScrollTrigger", "lenis"],
      "libs": ["react-fast-marquee", "react-type-animation", "lucide-react", "react-hook-form"],
      "content": "MDX",
      "hosting": "GitHub Pages"
    }
  },

  "theme": {
    "colors": {
      "ink": "#0A0A0A",
      "paper": "#FFFDF5",
      "primary": "#FFE14D",
      "accentPink": "#FF5DA2",
      "accentBlue": "#4D7CFF",
      "muted": "#E8E4D4"
    },
    "colorRules": [
      "Latar halaman selalu paper, teks selalu ink",
      "Maksimal 1 warna aksen dominan per section",
      "Dilarang gradasi dan transparansi",
      "Kontras teks minimal 7:1"
    ],
    "typography": {
      "display": { "family": "Bricolage Grotesque", "weight": 800, "transform": "uppercase", "tracking": "-0.04em", "leading": 0.9 },
      "body": { "family": "Space Grotesk", "weight": 500, "leading": 1.6 },
      "mono": { "family": "Space Mono", "weight": 700, "use": "label, nomor, tag, tombol kecil" },
      "scale": {
        "mega": "clamp(3.5rem, 12vw, 11rem)",
        "h1": "clamp(2.5rem, 7vw, 6rem)",
        "h2": "clamp(2rem, 5vw, 4rem)",
        "h3": "clamp(1.25rem, 2.5vw, 2rem)",
        "body": "1.0625rem",
        "label": "0.8125rem"
      }
    },
    "border": { "width": "4px", "style": "solid", "color": "ink", "radius": "0px" },
    "shadow": {
      "sm": "4px 4px 0 #0A0A0A",
      "md": "8px 8px 0 #0A0A0A",
      "lg": "14px 14px 0 #0A0A0A",
      "rule": "Tanpa blur, selalu warna ink solid"
    },
    "spacing": { "unit": 8, "sectionY": "clamp(5rem, 12vw, 10rem)", "containerMax": "1320px", "gutter": "clamp(1rem, 3vw, 2rem)" },
    "texture": {
      "noiseOverlay": { "enabled": true, "opacity": 0.06, "blend": "multiply" },
      "gridBackground": { "enabled": true, "size": "48px", "lineColor": "muted", "sections": ["hero", "contact"] }
    }
  },

  "layout": {
    "grid": { "columns": 12, "gap": "gutter" },
    "breakpoints": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280 },
    "principles": [
      "Asimetris: elemen boleh keluar dari grid 8-24px",
      "Rotasi kecil (-4 sampai 4 derajat) hanya pada stiker, foto, dan kartu pilihan",
      "Teks tidak boleh ikut miring, hanya wadahnya",
      "Satu elemen 'rusak' sengaja per section, sisanya rapi"
    ]
  },

  "global": {
    "cursor": {
      "enabled": true,
      "desktopOnly": true,
      "default": { "shape": "square", "size": 16, "color": "ink", "border": "2px paper" },
      "onLink": { "size": 56, "background": "primary", "label": "BUKA", "font": "mono" },
      "onProject": { "size": 88, "background": "accentPink", "label": "LIHAT" }
    },
    "scrollProgress": { "position": "top", "height": "8px", "color": "accentPink", "borderBottom": "2px ink" },
    "smoothScroll": { "lib": "lenis", "duration": 1.1 },
    "pageTransition": { "type": "block-wipe", "blocks": 5, "color": ["primary", "accentPink", "accentBlue", "ink", "paper"], "stagger": 0.06, "duration": 0.5 }
  },

  "sections": [
    {
      "id": "navbar",
      "type": "navbar",
      "sticky": true,
      "height": "72px",
      "style": { "background": "paper", "borderBottom": "4px ink" },
      "left": { "type": "logo", "text": "[INISIAL].", "font": "display", "hover": "bg primary, rotate -3deg" },
      "center": { "links": ["Proyek", "Tentang", "Skill", "Kontak"], "font": "mono", "hover": "underline tebal 4px warna primary" },
      "right": { "type": "button", "text": "DOWNLOAD CV", "variant": "primary", "icon": "download" },
      "mobile": { "pattern": "fullscreen-overlay", "trigger": "tombol MENU kotak bergaya brutal", "linksFont": "mega", "animation": "slide dari kanan dengan stagger" }
    },

    {
      "id": "hero",
      "type": "hero",
      "minHeight": "calc(100vh - 72px)",
      "background": "paper + gridBackground",
      "layout": {
        "desktop": "teks kolom 1-7, foto kolom 8-12 (menimpa batas kolom 24px)",
        "mobile": "foto di atas (lebar 80%), teks di bawah"
      },
      "content": {
        "eyebrow": { "type": "label", "text": "● TERSEDIA UNTUK KERJA / FREELANCE", "style": "mono, background primary, border 3px ink, padding 4px 12px" },
        "heading": {
          "lines": ["HALO, SAYA", "[NAMA]", "[PROFESI]."],
          "size": "mega",
          "emphasis": [
            { "line": 2, "style": "highlight primary di belakang teks, miring -2deg" },
            { "line": 3, "style": "outline text, stroke 3px ink, fill transparan" }
          ]
        },
        "subheading": {
          "type": "typewriter",
          "lib": "react-type-animation",
          "sequence": ["Membangun [HAL 1].", "Merancang [HAL 2].", "Mengubah ide jadi [HAL 3]."],
          "font": "mono"
        },
        "cta": [
          { "text": "LIHAT PROYEK", "variant": "primary", "icon": "arrow-down-right", "target": "#projects" },
          { "text": "HUBUNGI SAYA", "variant": "outline", "icon": "mail", "target": "#contact" }
        ]
      },
      "photo": {
        "src": "/images/hero-photo.jpg",
        "alt": "Foto [NAMA KAMU]",
        "aspectRatio": "4/5",
        "recommendedSource": "Foto setengah badan, latar polos, cahaya tegas, resolusi min 1200x1500",
        "frame": {
          "border": "4px ink",
          "shadow": "lg",
          "rotate": "3deg",
          "backgroundLayer": { "color": "primary", "offset": "-20px 20px", "border": "4px ink", "rotate": "-3deg" }
        },
        "treatment": {
          "default": "grayscale 100%, contrast 130%, halftone dots overlay 15%",
          "hover": "warna asli muncul, frame rotate 0deg, shadow menyusut ke md",
          "mobile": "tanpa hover, warna asli tampil terus"
        },
        "decorations": [
          { "type": "sticker", "text": "OPEN TO WORK", "shape": "starburst", "color": "accentPink", "position": "top -24px right -24px", "animation": "rotate-slow 12s linear infinite" },
          { "type": "tape", "color": "muted", "position": "top center", "rotate": "-6deg", "size": "96x28" },
          { "type": "label", "text": "FIG. 01 — [NAMA]", "font": "mono", "position": "bottom -14px left 16px", "background": "paper", "border": "3px ink" },
          { "type": "circular-text", "text": "• DESAIN • KODE • KARYA • ", "position": "bottom -40px left -40px", "size": 120, "animation": "rotate-slow 18s linear infinite reverse" }
        ]
      },
      "animations": {
        "heading": { "preset": "line-reveal", "stagger": 0.12, "from": "y: 110%, clip" },
        "photo": { "preset": "stamp", "delay": 0.4 },
        "stickers": { "preset": "pop-in", "delay": 0.9 },
        "eyebrow": { "preset": "blink-dot" },
        "parallax": { "photo": 0.08, "backgroundLayer": -0.04 }
      }
    },

    {
      "id": "marquee-1",
      "type": "marquee",
      "height": "72px",
      "style": { "background": "ink", "color": "primary", "borderY": "4px ink", "rotate": "-1.5deg", "overflow": "bleed" },
      "items": ["[BIDANG 1]", "✱", "[BIDANG 2]", "✱", "[BIDANG 3]", "✱", "SIAP KOLABORASI", "✱"],
      "font": "display",
      "speed": 60,
      "direction": "left",
      "pauseOnHover": true
    },

    {
      "id": "about",
      "type": "about",
      "heading": { "label": "01 / TENTANG", "text": "SIAPA SAYA?" },
      "layout": "foto kolom 1-5, teks kolom 6-12",
      "photo": {
        "src": "/images/about-photo.jpg",
        "alt": "[NAMA KAMU] sedang bekerja",
        "recommendedSource": "Foto candid saat bekerja, beda dari foto hero",
        "frame": { "border": "4px ink", "shadow": "md", "rotate": "-2deg" },
        "treatment": "duotone ink + primary, hover: warna asli",
        "decorations": [
          { "type": "sticky-note", "text": "[FUN FACT SINGKAT]", "color": "primary", "position": "bottom -20px right -20px", "rotate": "5deg", "border": "3px ink" }
        ]
      },
      "text": {
        "paragraphs": ["[PARAGRAF 1: siapa kamu dan apa yang kamu lakukan]", "[PARAGRAF 2: apa yang kamu cari / nilai kerja kamu]"],
        "highlightStyle": "kata kunci dibungkus highlight primary"
      },
      "stats": {
        "layout": "3 kotak sejajar",
        "items": [
          { "value": 0, "suffix": "+", "label": "Proyek selesai" },
          { "value": 0, "suffix": "", "label": "Tahun belajar" },
          { "value": 0, "suffix": "+", "label": "Sertifikat" }
        ],
        "boxStyle": "border 4px ink, shadow sm, warna latar bergantian primary / accentPink / accentBlue",
        "animation": "count-up saat masuk viewport, durasi 1.4s"
      },
      "animations": {
        "photo": { "preset": "slide-in-left", "rotateFrom": "-8deg" },
        "text": { "preset": "reveal-up", "stagger": 0.1 },
        "stats": { "preset": "stamp", "stagger": 0.15 }
      }
    },

    {
      "id": "projects",
      "type": "projects",
      "heading": { "label": "02 / KARYA", "text": "PROYEK PILIHAN" },
      "layout": "daftar vertikal, kartu besar selang-seling kiri dan kanan",
      "limit": 5,
      "card": {
        "structure": ["nomor besar", "thumbnail", "judul", "deskripsi satu kalimat", "tag tech", "tombol"],
        "style": { "border": "4px ink", "shadow": "md", "background": "paper" },
        "thumbnail": {
          "aspectRatio": "16/10",
          "border": "4px ink",
          "treatment": "grayscale default, warna saat hover",
          "overlay": { "type": "status-badge", "examples": ["LIVE", "WIP", "OPEN SOURCE"], "style": "mono, background primary, border 3px ink" }
        },
        "number": { "font": "mega", "style": "outline stroke 3px ink, di belakang judul", "format": "01" },
        "tags": { "font": "mono", "style": "border 2px ink, padding 2px 8px" },
        "button": { "text": "BACA STUDI KASUS", "variant": "outline", "icon": "arrow-up-right" },
        "rotationPattern": ["-1deg", "1deg", "-0.5deg", "1.5deg", "-1deg"],
        "hover": {
          "transform": "translate(-6px, -6px)",
          "shadow": "lg",
          "rotate": "0deg",
          "thumbnail": "warna asli + scale 1.04",
          "cursor": "onProject"
        },
        "active": { "transform": "translate(4px, 4px)", "shadow": "sm" }
      },
      "caseStudyFields": ["masalah", "peran", "proses", "tools", "hasil", "tautan live / repo"],
      "footerCta": { "text": "LIHAT SEMUA PROYEK →", "variant": "primary", "target": "/projects" },
      "animations": {
        "card": { "preset": "reveal-up", "scrub": false, "once": true },
        "number": { "preset": "parallax", "speed": -0.15 },
        "stackEffect": "kartu menumpuk sticky saat scroll (GSAP ScrollTrigger pin)"
      }
    },

    {
      "id": "marquee-2",
      "type": "marquee",
      "height": "64px",
      "style": { "background": "primary", "color": "ink", "borderY": "4px ink", "rotate": "1deg" },
      "items": ["REACT", "✱", "NEXT.JS", "✱", "TYPESCRIPT", "✱", "TAILWIND", "✱", "[TOOLS LAIN]", "✱"],
      "font": "mono",
      "speed": 45,
      "direction": "right",
      "pauseOnHover": true
    },

    {
      "id": "skills",
      "type": "skills",
      "heading": { "label": "03 / SENJATA", "text": "SKILL & TOOLS" },
      "layout": "3 kolom kategori di desktop, 1 kolom di mobile",
      "groups": [
        { "title": "FRONTEND", "color": "primary", "items": ["[SKILL]", "[SKILL]", "[SKILL]"] },
        { "title": "DESAIN / KREATIF", "color": "accentPink", "items": ["[SKILL]", "[SKILL]", "[SKILL]"] },
        { "title": "LAINNYA", "color": "accentBlue", "items": ["[SKILL]", "[SKILL]", "[SKILL]"] }
      ],
      "groupStyle": { "border": "4px ink", "shadow": "md", "headerBackground": "group.color", "headerFont": "display" },
      "chip": {
        "style": { "border": "3px ink", "background": "paper", "font": "mono", "padding": "6px 14px" },
        "hover": "background group.color, rotate random(-3,3)deg, translateY(-4px)"
      },
      "animations": { "chips": { "preset": "pop-in", "stagger": 0.04 } }
    },

    {
      "id": "experience",
      "type": "timeline",
      "heading": { "label": "04 / JEJAK", "text": "PENGALAMAN & PENDIDIKAN" },
      "layout": "garis vertikal tengah di desktop, kiri di mobile",
      "line": { "width": "6px", "color": "ink" },
      "node": { "shape": "square", "size": 28, "border": "4px ink", "fill": "primary" },
      "entry": {
        "fields": ["periode", "judul", "institusi", "deskripsi singkat"],
        "card": { "border": "4px ink", "shadow": "sm", "background": "paper" },
        "period": { "font": "mono", "style": "label background ink, teks paper" }
      },
      "items": [
        { "period": "[TAHUN – TAHUN]", "title": "[JUDUL]", "org": "[INSTITUSI]", "summary": "[DESKRIPSI 1 KALIMAT]" },
        { "period": "[TAHUN – TAHUN]", "title": "[JUDUL]", "org": "[INSTITUSI]", "summary": "[DESKRIPSI 1 KALIMAT]" }
      ],
      "animations": {
        "line": { "preset": "draw-line", "scrub": true },
        "node": { "preset": "pop-in" },
        "card": { "preset": "slide-in-alternate" }
      }
    },

    {
      "id": "downloads",
      "type": "download-cta",
      "heading": { "label": "05 / BAWA PULANG", "text": "UNDUH BERKAS" },
      "layout": "2 kotak besar sejajar",
      "items": [
        { "title": "CV (ATS)", "description": "Format ringkas, mudah dibaca sistem rekrutmen.", "file": "/files/cv-nama.pdf", "icon": "file-text", "color": "primary", "button": "DOWNLOAD CV" },
        { "title": "PORTOFOLIO PDF", "description": "Kumpulan karya terbaik dalam satu berkas.", "file": "/files/portfolio-nama.pdf", "icon": "folder", "color": "accentPink", "button": "DOWNLOAD PORTOFOLIO" }
      ],
      "boxStyle": { "border": "4px ink", "shadow": "lg", "padding": "2.5rem" },
      "hover": "box bergeser (-6,-6), ikon bergoyang (wiggle)",
      "note": "CV kreatif dan akademik dikirim hanya jika diminta"
    },

    {
      "id": "contact",
      "type": "contact",
      "background": "ink + gridBackground (garis warna primary opacity 12%)",
      "color": "paper",
      "heading": { "text": "MARI KERJA BARENG.", "size": "mega", "highlightWord": "KERJA", "highlightStyle": "background primary, color ink, rotate -2deg" },
      "layout": "heading penuh lebar, form kolom 1-7, info kolom 8-12",
      "form": {
        "provider": "Formspree / Web3Forms",
        "lib": "react-hook-form",
        "fields": [
          { "name": "nama", "label": "NAMA", "type": "text", "required": true },
          { "name": "email", "label": "EMAIL", "type": "email", "required": true },
          { "name": "pesan", "label": "PESAN", "type": "textarea", "rows": 5, "required": true }
        ],
        "fieldStyle": { "border": "4px paper", "background": "ink", "color": "paper", "focus": "border primary, shadow 6px 6px 0 primary" },
        "submit": { "text": "KIRIM PESAN →", "variant": "primary" },
        "states": { "success": "kotak hijau/primary: PESAN TERKIRIM!", "error": "kotak accentPink: GAGAL, COBA LAGI" }
      },
      "info": {
        "email": { "value": "[EMAIL]", "action": "klik untuk salin, tampilkan toast 'TERSALIN!'" },
        "socials": [
          { "label": "LINKEDIN", "url": "[URL]" },
          { "label": "GITHUB", "url": "[URL]" },
          { "label": "INSTAGRAM", "url": "[URL]" }
        ],
        "socialStyle": "tombol kotak border 3px paper, hover background primary dan teks ink"
      },
      "animations": { "heading": { "preset": "line-reveal" }, "form": { "preset": "reveal-up" } }
    },

    {
      "id": "footer",
      "type": "footer",
      "style": { "background": "paper", "borderTop": "4px ink" },
      "left": "© 2026 [NAMA KAMU]",
      "center": "Dibuat dengan Next.js & kopi.",
      "right": { "type": "button", "text": "↑ KE ATAS", "variant": "outline", "action": "smooth scroll ke atas" }
    }
  ],

  "components": {
    "button": {
      "base": { "border": "4px ink", "font": "mono", "uppercase": true, "padding": "14px 28px", "shadow": "sm", "radius": 0 },
      "variants": {
        "primary": { "background": "primary", "color": "ink" },
        "outline": { "background": "paper", "color": "ink" },
        "dark": { "background": "ink", "color": "paper" }
      },
      "hover": { "transform": "translate(-3px, -3px)", "shadow": "md" },
      "active": { "transform": "translate(4px, 4px)", "shadow": "none" },
      "focusVisible": { "outline": "4px solid accentBlue", "offset": "4px" }
    },
    "sticker": {
      "shapes": ["starburst", "circle", "rect-tilted"],
      "style": { "border": "3px ink", "font": "mono", "shadow": "sm" }
    },
    "label": { "font": "mono", "style": "background paper, border 3px ink, padding 2px 10px" }
  },

  "animationPresets": {
    "line-reveal": { "lib": "motion", "from": { "y": "110%" }, "to": { "y": "0%" }, "duration": 0.7, "ease": [0.76, 0, 0.24, 1], "mask": "overflow hidden per baris" },
    "reveal-up": { "lib": "motion", "from": { "opacity": 0, "y": 40 }, "to": { "opacity": 1, "y": 0 }, "duration": 0.5, "ease": "easeOut", "once": true },
    "stamp": { "lib": "motion", "from": { "opacity": 0, "scale": 1.25, "rotate": 6 }, "to": { "opacity": 1, "scale": 1, "rotate": "target" }, "duration": 0.35, "ease": [0.34, 1.56, 0.64, 1], "note": "efek dicap, cepat dan tegas" },
    "pop-in": { "lib": "motion", "from": { "opacity": 0, "scale": 0 }, "to": { "opacity": 1, "scale": 1 }, "type": "spring", "stiffness": 400, "damping": 15 },
    "slide-in-left": { "lib": "motion", "from": { "opacity": 0, "x": -80 }, "to": { "opacity": 1, "x": 0 }, "duration": 0.6, "ease": "easeOut" },
    "slide-in-alternate": { "lib": "motion", "from": { "opacity": 0, "x": "±80" }, "to": { "opacity": 1, "x": 0 }, "note": "ganjil dari kiri, genap dari kanan" },
    "rotate-slow": { "css": "keyframes rotate 360deg", "timing": "linear", "iteration": "infinite" },
    "wiggle": { "lib": "motion", "keyframes": { "rotate": [0, -6, 6, -4, 4, 0] }, "duration": 0.5 },
    "blink-dot": { "css": "opacity 1 -> 0 -> 1", "duration": "1.2s", "iteration": "infinite", "timing": "steps(1)" },
    "draw-line": { "lib": "gsap", "property": "scaleY 0 -> 1", "origin": "top", "scrub": true },
    "parallax": { "lib": "gsap + ScrollTrigger", "note": "kecepatan kecil agar tidak memusingkan" }
  },

  "performance": {
    "images": { "format": "webp", "maxHeroKB": 250, "loading": { "hero": "eager", "others": "lazy" }, "note": "next/image dengan unoptimized: true, kompres manual sebelum upload" },
    "fonts": "next/font, maksimal 3 family, display: swap",
    "animations": "hanya animasikan transform dan opacity",
    "targets": { "lighthouse": 90, "lcp": "< 2.5s" }
  },

  "accessibility": {
    "reducedMotion": "nonaktifkan marquee, parallax, rotate-slow, dan page transition; ganti dengan fade sederhana",
    "keyboard": "semua elemen interaktif dapat difokus dengan outline 4px accentBlue",
    "altText": "wajib untuk semua foto dan thumbnail",
    "contrast": "teks di atas primary, accentPink, dan accentBlue selalu ink",
    "cursor": "kursor kustom dimatikan di perangkat sentuh dan saat reducedMotion aktif",
    "semantics": "gunakan header, nav, main, section, footer; satu h1 saja"
  },

  "responsive": {
    "mobile": {
      "hero": "foto di atas, heading size h1 (bukan mega)",
      "projects": "kartu satu kolom, rotasi dikurangi setengah",
      "marquee": "tinggi 56px",
      "shadow": "turunkan satu tingkat (lg jadi md)",
      "overflow": "pastikan tidak ada scroll horizontal akibat elemen yang menjorok"
    }
  },

  "contentChecklist": [
    "Foto hero (setengah badan, latar polos)",
    "Foto about (candid saat bekerja)",
    "3-5 proyek: judul, thumbnail, deskripsi, tag, studi kasus",
    "Daftar skill per kategori",
    "Pengalaman dan pendidikan",
    "File CV (ATS) dan Portofolio PDF",
    "Email dan link sosial media"
  ]
}
